<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.GestionUtilisateursController"
      spacing="12"
      style="-fx-background-color: #f4f6f9;">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Gestion des utilisateurs"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Label fx:id="statusLabel" style="-fx-text-fill: #666;"/>

    <TableView fx:id="tableUsers" VBox.vgrow="ALWAYS" prefHeight="300">
        <columns>
            <TableColumn fx:id="colId"       text="Id"       prefWidth="60"/>
            <TableColumn fx:id="colUsername"  text="Username" prefWidth="200"/>
            <TableColumn fx:id="colRole"      text="Rôle"     prefWidth="120"/>
        </columns>
    </TableView>

    <TitledPane text="Ajouter un utilisateur" collapsible="false"
                style="-fx-font-weight: bold;">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

            <Label text="Username"/>
            <TextField fx:id="fieldUsername" prefWidth="160" promptText="Nom d'utilisateur"/>

            <Label text="Mot de passe"/>
            <PasswordField fx:id="fieldPassword" prefWidth="140" promptText="Mot de passe"/>

            <Label text="Rôle"/>
            <ComboBox fx:id="comboRole" prefWidth="110"/>
        </HBox>
    </TitledPane>

    <HBox spacing="10">
        <Button text="Ajouter"    onAction="#handleAjouter"   style="-fx-background-color:#2E8B57;-fx-text-fill:white;"/>
        <Button text="Supprimer"  onAction="#handleSupprimer" style="-fx-background-color:#C0392B;-fx-text-fill:white;"/>
        <Button text="Rafraîchir" onAction="#handleRafraichir" style="-fx-background-color:#7f8c8d;-fx-text-fill:white;"/>
    </HBox>

</VBox>
