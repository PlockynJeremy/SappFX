<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.HomeController"
      alignment="TOP_CENTER"
      spacing="20"
      style="-fx-background-color: #f4f6f9;">

    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

    <Label text="SAPP"
           style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Label text="Votre boutique streetwear &amp; lifestyle"
           style="-fx-font-size: 18px; -fx-text-fill: #555;"/>

    <Separator prefWidth="500"/>

    <Label wrapText="true" maxWidth="620"
           text="Bienvenue chez Sapp — la marque qui allie style urbain et confort du quotidien. Retrouvez notre sélection de vêtements, chaussures et accessoires soigneusement choisis pour tous les styles et toutes les occasions."
           style="-fx-font-size: 14px; -fx-text-fill: #444;"/>

    <Separator prefWidth="500"/>

    <HBox spacing="30" alignment="CENTER">

        <VBox alignment="CENTER" spacing="6" prefWidth="180"
              style="-fx-background-color:white;-fx-border-color:#dde1e7;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:20;">
            <Label text="👕" style="-fx-font-size:28px;"/>
            <Label text="Qualité" style="-fx-font-weight:bold;-fx-font-size:14px;"/>
            <Label text="Des pièces sélectionnées avec soin." wrapText="true"
                   style="-fx-font-size:12px;-fx-text-fill:#777;" maxWidth="160"/>
        </VBox>

        <VBox alignment="CENTER" spacing="6" prefWidth="180"
              style="-fx-background-color:white;-fx-border-color:#dde1e7;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:20;">
            <Label text="🚚" style="-fx-font-size:28px;"/>
            <Label text="Livraison rapide" style="-fx-font-weight:bold;-fx-font-size:14px;"/>
            <Label text="Partout en France en 48h." wrapText="true"
                   style="-fx-font-size:12px;-fx-text-fill:#777;" maxWidth="160"/>
        </VBox>

        <VBox alignment="CENTER" spacing="6" prefWidth="180"
              style="-fx-background-color:white;-fx-border-color:#dde1e7;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:20;">
            <Label text="♻️" style="-fx-font-size:28px;"/>
            <Label text="Éco-responsable" style="-fx-font-weight:bold;-fx-font-size:14px;"/>
            <Label text="Emballages recyclés, circuits courts." wrapText="true"
                   style="-fx-font-size:12px;-fx-text-fill:#777;" maxWidth="160"/>
        </VBox>

    </HBox>

</VBox>
